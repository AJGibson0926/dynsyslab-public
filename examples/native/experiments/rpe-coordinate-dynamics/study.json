      "decimation": 1,
      "delays": 12751,
      "hankel_rank": 8,
      "coordinate_rank": 4,
      "hankel_oversampling": 16,
      "hankel_subspace_iterations": 32,
      "seed": 20261104,
      "observation_units": "Pa m",
      "diagnostics": {
        "crossings": {
          "axes": [
