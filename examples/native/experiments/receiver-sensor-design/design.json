{
  "schema": "dynsyslab.compute-job/v1",
  "kind": "experiment",
  "label": "receiver sensor design",
  "description": "Which receivers, pressure terms and readout recover a held-out free RPE ringdown best (docs/architecture/RECEIVER_ARRAYS.md). Training and held-out are two distinct free ringdowns of the same bubble, solved by the first two stages (initial radius set by --param training_radius=... and --param held_out_radius=...).",
  "parameters": {
    "training_radius": 1.3,
    "held_out_radius": 0.8,
    "neighbors": 8
  },
  "stages": [
    {"id": "training", "job": {"kind": "solve", "label": "receiver-design-training",
      "system": {"name": "rpe", "preset": "air_water_20c", "parameters": {}},
      "time": {"start": 0, "stop": 100, "output_step": 0.01},
      "solver": {"method": "BDF", "rtol": 1e-9, "atol": 1e-11},
      "initial_conditions": {"mode": "explicit", "count": 1, "clusters": 1, "seed": 0, "values": [["${params.training_radius}", 0]], "ranges": []},
      "campaign": {"enabled": false}, "preflight": {"enabled": false},
      "archive": {"enabled": true, "data_role": "free_training"}}},
    {"id": "held_out", "job": {"kind": "solve", "label": "receiver-design-held-out",
      "system": {"name": "rpe", "preset": "air_water_20c", "parameters": {}},
      "time": {"start": 0, "stop": 100, "output_step": 0.01},
      "solver": {"method": "BDF", "rtol": 1e-9, "atol": 1e-11},
      "initial_conditions": {"mode": "explicit", "count": 1, "clusters": 1, "seed": 0, "values": [["${params.held_out_radius}", 0]], "ranges": []},
      "campaign": {"enabled": false}, "preflight": {"enabled": false},
      "archive": {"enabled": true, "data_role": "free_training"}}},
    {"id": "design", "sweep": {
      "mode": "zip",
      "variables": {
        "terms": [["monopole_pressure"], ["monopole_pressure"], ["monopole_pressure", "spherical_near_field_pressure"],
                  ["monopole_pressure", "spherical_near_field_pressure"], ["monopole_pressure"]],
        "receivers": [[[0.005, 0, 0]], [[0.005, 0, 0], [0, 0.006, 0]], [[0.005, 0, 0], [0, 0.006, 0]],
                      [[0.005, 0, 0], [0, 0.006, 0]], [[0.005, 0, 0], [0, 0.006, 0]]],
        "contrast": [false, false, false, true, false],
        "mode": ["neighbors", "neighbors", "neighbors", "neighbors", "linear"]
      },
      "order": ["terms", "receivers", "contrast", "mode"],
      "stages": [
        {"id": "train", "job": {"kind": "postprocess", "sources": ["${training.archive}"], "methods": [{"name": "receiver_signals",
          "settings": {"receivers": "${sweep.receivers}", "sound_speed": 1480, "stride": 40, "terms": "${sweep.terms}",
                       "range_corrected": true, "contrast": "${sweep.contrast}"}}]}},
        {"id": "held", "job": {"kind": "postprocess", "sources": ["${held_out.archive}"], "methods": [{"name": "receiver_signals",
          "settings": {"receivers": "${sweep.receivers}", "sound_speed": 1480, "stride": 40, "terms": "${sweep.terms}",
                       "range_corrected": true, "contrast": "${sweep.contrast}"}}]}},
        {"id": "readout", "job": {"kind": "postprocess", "sources": ["${held.archive}"], "methods": [{"name": "state_readout",
          "settings": {"training": ["${train.archive}"], "mode": "${sweep.mode}", "neighbors": "${params.neighbors}",
                       "scales": "shared", "equilibrium": [1, 0]}}]}},
        {"id": "score", "job": {"kind": "postprocess", "sources": ["${readout.archive}"], "methods": [{"name": "ring_errors",
          "settings": {"center": [1, 0], "role": "validation", "windows": {"early": [0, 5], "late": [76, 1e9]}}}]}}
      ]}},
    {"id": "best", "select": {"sweep": "design", "stage": "score", "metric": "validation.relative_rms_percent",
                              "reduce": "mean", "goal": "minimize"}}
  ]
}
