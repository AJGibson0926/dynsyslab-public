{
  "schema": "dynsyslab.compute-job/v1",
  "kind": "experiment",
  "label": "RPE echo delay-length injectivity sweep",
  "description": "Top-two causal echo coordinates for a range of delay-window lengths: each fitted on the training records, projected through the frozen basis onto held-out records, and scored by cross-orbit crossings and peak closure of the held-out orbits (docs/architecture/TRAJECTORY_KERNELS.md). Replaces tools/sweep_rpe_echo_delay_injectivity.py and tools/analyze_rpe_echo_hankel_delay_sweep.py.",
  "parameters": {
    "training": ["<free RPE trajectory archives for the basis>"],
    "validation": ["<held-out free RPE trajectory archives>"],
    "groups": ["inside", "inside", "inside", "outside", "outside"]
  },
  "stages": [
    {"id": "delays", "sweep": {
      "variables": {"delays": [160, 319, 638, 956, 1275, 1913, 2550, 3825, 5100]},
      "stages": [
        {"id": "basis", "job": {"kind": "postprocess", "sources": "${params.training}", "methods": [{"name": "history_basis",
          "settings": {"observable": "far_field_acoustic_echo", "delays": "${sweep.delays}", "hankel_rank": 8, "coordinate_rank": 2,
                       "decimation": 1, "seed": 20261104, "time_units": "dimensionless tau", "observation_units": "Pa m"}}]}},
        {"id": "project", "job": {"kind": "postprocess", "sources": "${params.validation}", "methods": [{"name": "history_projection",
          "settings": {"transform": "${basis.archive}", "observable": "far_field_acoustic_echo", "decimation": 1,
                       "time_units": "dimensionless tau", "observation_units": "Pa m"}}]}},
        {"id": "score", "job": {"kind": "postprocess", "sources": "${project.archives}", "methods": [{"name": "orbit_geometry",
          "settings": {"role": "validation", "axes": [0, 1], "groups": "${params.groups}",
                       "peaks": {"array": "measurement_values", "prominence": 0.15, "min_spacing_time": 0.5}}}]}}
      ]}},
    {"id": "fewest_crossings", "select": {"sweep": "delays", "stage": "score", "metric": "validation.crossings", "goal": "minimize"}},
    {"id": "best_closure", "select": {"sweep": "delays", "stage": "score", "metric": "validation.peak_closure_median", "goal": "minimize"}}
  ]
}
