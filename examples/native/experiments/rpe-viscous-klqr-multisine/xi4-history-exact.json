{
  "schema": "dynsyslab.compute-job/v1",
  "kind": "experiment",
  "extends": "examples/native/experiments/rpe-viscous-klqr-multisine/base-r.json",
  "label": "rpe-viscous-klqr-multisine-xi4-exact",
  "description": "Coordinate chain (r, v) -> (e, e') -> (xi_1..xi_4): the state is mapped to echo_jet2, then the first four Hankel-SVD coordinates of the echo column's history (Codex basis, 1.275 tau window) are fitted and projected, all in the coordinate-change stage. H-DMD builds its Hankel matrices from xi_1; SINDy fits in xi. Same KROM rule, Q/R and target. The controller forms xi causally from the measured echo; its input map is the state-informed history_exact chain rule.",
  "parameters": {
    "coordinates": {
      "kind": "chain",
      "steps": [
        {
          "kind": "observable",
          "observable": "echo_jet2",
          "labels": [
            "e",
            "e'"
          ]
        },
        {
          "kind": "history",
          "measurement": "far_field_acoustic_echo",
          "decimation": 1,
          "delays": 1275,
          "hankel_rank": 8,
          "coordinate_rank": 4,
          "hankel_oversampling": 16,
          "hankel_subspace_iterations": 32,
          "seed": 20261104,
          "observation_units": "Pa m"
        }
      ],
      "diagnostics": {
        "crossings": {
          "axes": [
            0,
            1
          ]
        }
      }
    },
    "sindy_gamma": "finite_difference",
    "xi_measurement": "far_field_acoustic_echo",
    "control_representation": "history_exact"
  },
  "overrides": {
    "control": {
      "controller": {
        "settings": {
          "measurement_observable": "${params.xi_measurement}",
          "warmup_input": 0
        }
      },
      "solver": {
        "control_evaluation": "sampled",
        "control_sample_time": 0.001
      }
    }
  }
}
