{
  "schema": "dynsyslab.compute-job/v1",
  "kind": "experiment",
  "label": "duffing-observable-spectra",
  "description": "Koopman spectra of two scalar observables of one Duffing trajectory: one H-DMD stage per observable with identical settings, then observable_spectrum_comparison (symmetric nearest-neighbour RMS distances between the spectra). Observables that see the same dynamics give nearby spectra (Mezic 2013; Arbabi & Mezic 2017).",
  "stages": [
    {
      "id": "train",
      "job": {
        "kind": "solve",
        "label": "duffing-observable-spectra-training",
        "system": {
          "name": "duffing",
          "parameters": {
            "alpha": -1,
            "beta": 0,
            "delta": 0.2
          }
        },
        "time": {
          "start": 0,
          "stop": 12,
          "output_step": 0.02,
          "coordinate_system": "automatic"
        },
        "initial_conditions": {
          "mode": "explicit",
          "count": 1,
          "clusters": 1,
          "values": [
            [
              1.0,
              0.0
            ]
          ]
        },
        "solver": {
          "method": "RK45",
          "rtol": 1e-10,
          "atol": 1e-12
        },
        "archive": {
          "enabled": true,
          "data_role": "free_training"
        }
      }
    },
    {
      "id": "position",
      "job": {
        "kind": "postprocess",
        "sources": [
          "${train.archive}"
        ],
        "methods": [
          {
            "name": "hdmd",
            "settings": {
              "observable": 0,
              "matrix_size": 200,
              "sampling_window": 100,
              "rank": 2
            }
          }
        ],
        "archive": {
          "enabled": true
        }
      }
    },
    {
      "id": "velocity",
      "job": {
        "kind": "postprocess",
        "sources": [
          "${train.archive}"
        ],
        "methods": [
          {
            "name": "hdmd",
            "settings": {
              "observable": 1,
              "matrix_size": 200,
              "sampling_window": 100,
              "rank": 2
            }
          }
        ],
        "archive": {
          "enabled": true
        }
      }
    },
    {
      "id": "compare",
      "job": {
        "kind": "postprocess",
        "sources": [
          "${position.archive}",
          "${velocity.archive}"
        ],
        "methods": [
          {
            "name": "observable_spectrum_comparison",
            "settings": {
              "names": [
                "position",
                "velocity"
              ]
            }
          }
        ],
        "archive": {
          "enabled": true
        }
      }
    }
  ]
}
