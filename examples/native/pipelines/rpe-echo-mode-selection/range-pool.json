{
  "schema": "dynsyslab.compute-job/v1",
  "kind": "pipeline",
  "label": "rpe-echo-mode-selection-range",
  "description": "Mode selection over the widest region where H-DMD still yields genuine eigenfunctions. Pool: joint H-DMD of [radius, radial_velocity, far_field_acoustic_echo] on the small-amplitude free decay (validation trajectory 0, r0 = 1.1, r'0 = 0.3) over 'hdmd_window' (default 0-42: amplitude 0.115 down to 0.01 around equilibrium, which covers the mild target and the start-up). Large-amplitude windows of the r0 = 2.0 decay were tried and lose the genuine fundamental pair (see the case-study README). Eigenfunctions are interpolated in state space; no e' anywhere. Readouts are fitted on the same unforced window. B_psi is regressed on forced records inside the range: the mild-orbit full-state KLQR run of 2026-11-15 (an offline training experiment, drive recorded), an open-loop mild-orbit record, and the a005p05 / a02p2 random-pulse records. 'krom_units' writes a chosen unit subset instead of the composite pick (the best closed loop used [0]).",
  "parameters": {
    "unforced": "archives/solutions/rpe/rpe-viscous-echo-long-validation-five-ics-trajectory-0__20261002T001403Z.npz",
    "hdmd_window": [
      0,
      42
    ],
    "snapshot_stride": 20,
    "matrix_size": 2000,
    "pool_size": 10,
    "max_units": 4,
    "sensor_noise": 0.01,
    "krom_units": null
  },
  "stages": [
    {
      "id": "hdmd",
      "job": {
        "kind": "postprocess",
        "label": "rpe-echo-mode-selection-range / hdmd",
        "sources": [
          "${params.unforced}"
        ],
        "methods": [
          {
            "name": "hdmd",
            "settings": {
              "matrix_size": "${params.matrix_size}",
              "mode_sort": "terminal-amplitude-energy",
              "observables": [
                "radius",
                "radial_velocity",
                "far_field_acoustic_echo"
              ],
              "rank": 0,
              "reconstruction_observables": [
                "state"
              ],
              "sample_stride": 10,
              "sampling_window": 2000,
              "snapshot_stride": "${params.snapshot_stride}",
              "svd_tolerance": 1e-10,
              "time_window": "${params.hdmd_window}",
              "window_alignment": "start"
            }
          }
        ],
        "archive": {
          "enabled": true
        }
      }
    },
    {
      "id": "pool",
      "job": {
        "kind": "postprocess",
        "label": "rpe-echo-mode-selection-range / pool",
        "sources": [
          "${hdmd.archive}"
        ],
        "methods": [
          {
            "name": "krom_extract",
            "settings": {
              "mode_selection": {
                "rule": "observable_energy",
                "reconstructions": [
                  "radius",
                  "radial_velocity",
                  "far_field_acoustic_echo"
                ],
                "thresholds": [
                  0.9999,
                  0.9999,
                  0.9999
                ],
                "caps": [
                  24,
                  24,
                  24
                ],
                "max_real_part": 0,
                "exclude_constant": true
              }
            }
          }
        ],
        "archive": {
          "enabled": true
        }
      }
    },
    {
      "id": "selection",
      "job": {
        "kind": "postprocess",
        "label": "rpe-echo-mode-selection-range / selection",
        "sources": [
          "${params.unforced}",
          "archives/solutions/rpe/klqe-klqr-ee-ic37-mild-full-R0-01-ramp0__20261115T014805Z.npz",
          "archives/solutions/rpe/rpe-forced-target-orbit-mild__20261116T193824Z.npz",
          "archives/solutions/rpe/rpe-forced-bpsi-a005p05__20261114T033755Z.npz",
          "archives/solutions/rpe/rpe-forced-bpsi-a02p2__20261114T033756Z.npz"
        ],
        "methods": [
          {
            "name": "mode_selection",
            "settings": {
              "krom": "${pool.archive}",
              "measurement": "far_field_acoustic_echo",
              "time_window": "${params.hdmd_window}",
              "forced_time_window": [
                5,
                100
              ],
              "pool_size": "${params.pool_size}",
              "max_units": "${params.max_units}",
              "sensor_noise": "${params.sensor_noise}",
              "write_krom": true,
              "krom_units": "${params.krom_units}"
            }
          }
        ],
        "archive": {
          "enabled": true
        }
      }
    }
  ]
}