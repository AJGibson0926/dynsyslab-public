{
  "schema": "dynsyslab.compute-job/v1",
  "kind": "pipeline",
  "extends": "examples/native/pipelines/rpe-viscous-klqr-multisine/base-r.json",
  "label": "rpe-echo-jet-klqr-rediscovery-20kpa",
  "description": "Corrected-echo rerun of Codex's 14 September echo-jet KLQR driver rediscovery. Eigenfunctions come only from UNFORCED data: baseline RPE ('training') -> H-DMD -> state SINDy -> state K-ROM (spectrum) -> 'echo_coordinates' on the record named by 'echo_training' (default the baseline) -> eigenfunction SINDy -> echo K-ROM. The input matrix B_psi is chosen by one parameter, 'B_psi' (representation exact | history_exact | constant | bilinear, and for regressed maps fit / drift / ridge / fit_start), and regressed maps are fitted only on the FORCED record(s) of 'forced_training'. KLQR then tracks the 20 kPa, 100 kHz physical orbit for 300 tau with no pressure feedforward, and the controller's pressure is compared with the withheld sine. Causal-history coordinates (xi) need control_evaluation 'sampled' on the history clock. Toggles: 'control_limit' (null = uncapped; a number L caps to [-L, L]; [low, high] caps asymmetrically). The target is the state waveform 'target_state' (default: the 20 kPa orbit; any state target, with an optional 'ramp' {duration, from}); stage 'target_lift' maps it OFFLINE into the controller's coordinates (control_target), so online control evaluates no physical model for its reference ('target_step': the offline sampling step, default 0.001 = the history clock; continuous evaluation interpolates it linearly).",
  "parameters": {
    "Q": 5000,
    "R": 0.0001,
    "echo_training": "${train.archive}",
    "rediscovery_target": "archives/solutions/rpe/rpe-periodic-100khz-20kpa-phase-portrait__20260911T214426Z.npz",
    "echo_coordinates": {
      "kind": "observable",
      "observable": "echo_jet2",
      "labels": [
        "e",
        "e'"
      ],
      "diagnostics": {
        "crossings": {
          "axes": [
            0,
            1
          ]
        }
      }
    },
    "echo_sindy": {
      "spectrum_archive": "${artefact.archive}",
      "polynomial_degree": 4,
      "include_constant": false,
      "threshold": 1e-06,
      "max_iterations": 1,
      "normalize": true,
      "reuse_conjugate_fits": true,
      "compute_training_values": false,
      "gamma_method": "system_rhs",
      "include_input_terms": false,
      "reconstruction": "none"
    },
    "B_psi": {
      "representation": "exact"
    },
    "forced_training": {
      "kind": "solve",
      "system": "${params.system}",
      "time": {
        "start": 0,
        "stop": 60,
        "output_step": 0.001,
        "coordinate_system": "dimensionless"
      },
      "initial_conditions": {
        "mode": "explicit",
        "count": 1,
        "clusters": 1,
        "seed": 0,
        "values": [
          [
            1,
            0
          ]
        ],
        "ranges": []
      },
      "controller": {
        "kind": "random_pulse",
        "settings": {
          "model_amplitude": 0.2,
          "model_pulse_duration": 2.0,
          "seed": 15
        }
      },
      "solver": {
        "method": "BDF",
        "rtol": 1e-09,
        "atol": 1e-09,
        "max_step": 0.001
      },
      "archive": {
        "enabled": true,
        "data_role": "control_identification"
      }
    },
    "control_evaluation": "continuous_rhs",
    "control_sample_time": 0.001,
    "measurement_observable": "far_field_acoustic_echo",
    "control_stop": 300,
    "control_limit": null,
    "target_state": {
      "kind": "trajectory",
      "source": "${target_orbit.archive}",
      "time_array": "time",
      "value_array": "values",
      "ramp": null
    },
    "target_step": 0.001
  },
  "stages": [
    {
      "id": "echo_coords",
      "before": "control",
      "job": {
        "kind": "postprocess",
        "sources": [
          "${params.echo_training}"
        ],
        "methods": [
          {
            "name": "coordinate_transform",
            "settings": "${params.echo_coordinates}"
          }
        ],
        "archive": {
          "enabled": true
        }
      }
    },
    {
      "id": "echo_sindy",
      "before": "control",
      "job": {
        "kind": "postprocess",
        "sources": [
          "${echo_coords.archive}"
        ],
        "methods": [
          {
            "name": "sindy",
            "settings": "${params.echo_sindy}"
          }
        ],
        "archive": {
          "enabled": true
        }
      }
    },
    {
      "id": "echo_krom",
      "before": "control",
      "job": {
        "kind": "postprocess",
        "sources": [
          "${echo_sindy.archive}"
        ],
        "methods": [
          {
            "name": "krom_extract",
            "settings": {
              "mode_selection": {
                "rule": "oscillatory_pairs",
                "count": 1
              }
            }
          }
        ],
        "archive": {
          "enabled": true
        }
      }
    },
    {
      "id": "forced_training",
      "before": "control",
      "job": "${params.forced_training}"
    },
    {
      "id": "input_map",
      "before": "control",
      "job": {
        "kind": "postprocess",
        "sources": [
          "${forced_training.archive}"
        ],
        "methods": [
          {
            "name": "input_map",
            "settings": {
              "krom": "${echo_krom.archive}",
              "map": "${params.B_psi}"
            }
          }
        ],
        "archive": {
          "enabled": true
        }
      }
    },
    {
      "id": "target_orbit",
      "before": "control",
      "job": {
        "kind": "archive",
        "archives": [
          "${params.rediscovery_target}"
        ]
      }
    },
    {
      "id": "target_lift",
      "before": "control",
      "job": {
        "kind": "postprocess",
        "sources": [
          "${input_map.archive}"
        ],
        "methods": [
          {
            "name": "control_target",
            "settings": {
              "krom": "${input_map.archive}",
              "state_target": "${params.target_state}",
              "time": {
                "start": 0,
                "stop": "${params.control_stop}",
                "step": "${params.target_step}"
              }
            }
          }
        ],
        "archive": {
          "enabled": true
        }
      }
    },
    {
      "id": "control",
      "job": {
        "kind": "solve",
        "system": "${params.system}",
        "time": {
          "start": 0,
          "stop": "${params.control_stop}",
          "output_step": 0.02,
          "coordinate_system": "dimensionless"
        },
        "initial_conditions": {
          "mode": "explicit",
          "count": 1,
          "clusters": 1,
          "seed": 0,
          "values": [
            [
              1,
              0
            ]
          ],
          "ranges": []
        },
        "controller": {
          "kind": "klqr",
          "settings": {
            "krom": "${input_map.archive}",
            "control_representation": "${params.B_psi.representation}",
            "measurement_observable": "${params.measurement_observable}",
            "warmup_input": 0,
            "Q": "${params.Q}",
            "R": "${params.R}",
            "control_limit": "${params.control_limit}"
          },
          "target": {
            "space": "observable",
            "kind": "trajectory",
            "source": "${target_lift.archive}",
            "time_array": "time",
            "value_array": "values"
          }
        },
        "solver": {
          "method": "BDF",
          "rtol": 1e-09,
          "atol": 1e-09,
          "max_step": 0.001,
          "control_evaluation": "${params.control_evaluation}",
          "control_sample_time": "${params.control_sample_time}"
        },
        "archive": {
          "enabled": true,
          "data_role": "echo_derivative_driver_rediscovery"
        }
      }
    }
  ]
}