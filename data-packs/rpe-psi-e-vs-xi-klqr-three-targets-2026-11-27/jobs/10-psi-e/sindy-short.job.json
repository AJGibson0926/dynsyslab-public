{
 "schema": "dynsyslab.compute-job/v1",
 "kind": "postprocess",
 "label": "psi(e) SINDy short",
 "archive": {
  "enabled": true
 },
 "methods": [
  {
   "name": "sindy",
   "settings": {
    "compute_training_values": false,
    "gamma_method": "finite_difference",
    "include_constant": false,
    "include_input_terms": false,
    "max_iterations": 1,
    "normalize": true,
    "polynomial_degree": 4,
    "reconstruction": "none",
    "reuse_conjugate_fits": true,
    "sample_stride": 1,
    "spectrum_archive": "${inputs.spec}",
    "threshold": 1e-06,
    "time_window": [
     0,
     25
    ]
   }
  }
 ],
 "sources": [
  "${inputs.src}"
 ]
}