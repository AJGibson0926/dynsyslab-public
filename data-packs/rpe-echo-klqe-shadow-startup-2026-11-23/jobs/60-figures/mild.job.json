{
 "schema": "dynsyslab.compute-job/v1",
 "kind": "job_group",
 "label": "figures-mild",
 "jobs": [
  {
   "id": "f1-states",
   "inputs": {
    "table": "${inputs.table}"
   },
   "job": {
    "kind": "viewer_figure",
    "label": "shadow-mild-rr_1_states",
    "source": "${inputs.table}",
    "output": "shadow-mild-rr_1_states.png",
    "figure": {
     "view": "time-series",
     "style": "${params.style}",
     "curves": [
      {
       "series": "x",
       "label": "actual",
       "color": "#D8242A",
       "line_width": 2.7
      },
      {
       "series": "target",
       "label": "target",
       "color": "#004DB8",
       "line_style": "dash"
      },
      {
       "series": "xhat",
       "label": "echo-only KLQE estimate",
       "color": "#DE9B00",
       "line_style": "time-dash"
      }
     ],
     "axes": [
      "radius r",
      "radial velocity r-dot"
     ],
     "start": 0.0,
     "stop": 20.0,
     "width": 1400.0,
     "columns": 1.0,
     "time_label": "tau",
     "title": "mild, psi(r, r-dot) K-ROM, start-up: states",
     "height": 1000.0
    }
   }
  },
  {
   "id": "f2-phase",
   "inputs": {
    "table": "${inputs.table}"
   },
   "job": {
    "kind": "viewer_figure",
    "label": "shadow-mild-rr_2_phase",
    "source": "${inputs.table}",
    "output": "shadow-mild-rr_2_phase.png",
    "figure": {
     "view": "time-series",
     "style": "${params.style}",
     "curves": [
      {
       "series": "r,rdot",
       "label": "actual",
       "color": "#D8242A",
       "line_width": 2.7
      },
      {
       "series": "r_t,rdot_t",
       "label": "target",
       "color": "#004DB8",
       "line_style": "dash"
      },
      {
       "series": "r_hat,rdot_hat",
       "label": "echo-only KLQE estimate",
       "color": "#DE9B00",
       "line_style": "dash"
      }
     ],
     "axes": [
      "r-dot versus r"
     ],
     "start": 0.0,
     "stop": 20.0,
     "width": 1400.0,
     "x_label": "radius r",
     "value_label": "radial velocity r-dot",
     "title": "mild, psi(r, r-dot) K-ROM, start-up: phase portrait",
     "height": 1000.0
    }
   }
  },
  {
   "id": "f3-control",
   "inputs": {
    "table": "${inputs.table}"
   },
   "job": {
    "kind": "viewer_figure",
    "label": "shadow-mild-rr_3_control",
    "source": "${inputs.table}",
    "output": "shadow-mild-rr_3_control.png",
    "figure": {
     "view": "time-series",
     "style": "${params.style}",
     "curves": [
      {
       "series": "ideal",
       "label": "ideal drive (true-state KLQR, applied)",
       "color": "#D8242A",
       "line_width": 2.7
      },
      {
       "series": "klqr",
       "label": "KLQR force on the echo-only estimate (not applied)",
       "color": "#004DB8"
      }
     ],
     "axes": [
      "drive p/p0"
     ],
     "start": 0.0,
     "stop": 20.0,
     "width": 1400.0,
     "time_label": "tau",
     "title": "mild, psi(r, r-dot) K-ROM, start-up: control signals",
     "height": 700.0
    }
   }
  }
 ]
}
