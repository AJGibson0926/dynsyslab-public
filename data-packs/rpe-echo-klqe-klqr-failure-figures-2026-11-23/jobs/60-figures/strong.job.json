{
 "schema": "dynsyslab.compute-job/v1",
 "kind": "job_group",
 "label": "figures-strong",
 "jobs": [
  {
   "id": "strong-radius-startup-psi-r-rdot-exact-B",
   "inputs": {
    "table": "${inputs.strong_radius_psi_r_rdot_exact_B}"
   },
   "job": {
    "kind": "viewer_figure",
    "label": "strong_radius_startup_psi-r-rdot-exact-B",
    "source": "${inputs.table}",
    "output": "strong_radius_startup_psi-r-rdot-exact-B.png",
    "figure": {
     "view": "time-series",
     "style": "${params.style}",
     "curves": [
      {
       "series": "radius",
       "label": "Controlled",
       "color": "#202020",
       "line_width": 3.0,
       "line_style": "solid"
      },
      {
       "series": "target",
       "label": "Target",
       "color": "#D8242A",
       "line_width": 1.8,
       "line_style": "dash"
      }
     ],
     "axes": [
      "ψ(r, r'), exact B_{\\psi}"
     ],
     "value_label": "r",
     "title": "Strong target, start-up",
     "time_label": "Time (τ)",
     "width": 1400.0,
     "height": 800.0,
     "start": 0.0,
     "stop": 25.0
    }
   }
  },
