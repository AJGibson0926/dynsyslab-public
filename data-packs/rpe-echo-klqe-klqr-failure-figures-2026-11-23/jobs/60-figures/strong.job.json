      },
      {
       "series": "u1",
       "label": "ψ(e, e'), exact B_{\\psi}",
       "color": "#DE9B00",
       "line_width": 1.8,
       "line_style": "solid"
      },
      {
       "series": "u2",
       "label": "ψ(ξ), regressed B_{\\psi}",
       "color": "#1E7B4F",
