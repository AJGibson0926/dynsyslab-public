{
 "schema": "dynsyslab.compute-job/v1",
 "kind": "postprocess",
 "label": "mild_phase_psi-e-edot-exact-B",
 "sources": [
  "${inputs.base}"
 ],
 "methods": [
  {
   "name": "figure_dataset",
   "settings": {
    "inputs": {
     "base": "${inputs.base}",
     "ref": "${inputs.ref}",
     "run": "${inputs.run}"
    },
    "arrays": [
     {
      "name": "time",
      "from": "base",
      "array": "time",
      "column": 0
     },
     {
      "name": "r",
      "from": "run",
      "array": "values",
      "column": 0,
      "onto": {
       "from": "base",
       "array": "time"
      }
     },
     {
      "name": "v",
      "from": "run",
      "array": "values",
      "column": 1,
      "onto": {
       "from": "base",
       "array": "time"
      }
     },
     {
      "name": "rT",
      "from": "ref",
      "array": "target_values",
      "column": 0
     },
     {
      "name": "vT",
      "from": "ref",
      "array": "target_values",
      "column": 1
     }
    ]
   }
  }
 ],
 "archive": {
  "enabled": true
 },
 "resources": {
  "peak_bytes": 30000000
 }
}
