{
 "schema": "dynsyslab.compute-job/v1",
 "kind": "postprocess",
 "label": "mild_phase_klqe-klqr-echo-only",
 "sources": [
  "${inputs.std}"
 ],
 "methods": [
  {
   "name": "figure_dataset",
   "settings": {
    "inputs": {
     "std": "${inputs.std}"
    },
    "arrays": [
     {
      "name": "time",
      "from": "std",
      "array": "time",
      "column": 0
     },
     {
      "name": "r",
      "from": "std",
      "array": "values",
      "column": 0
     },
     {
      "name": "v",
      "from": "std",
      "array": "values",
      "column": 1
     },
     {
      "name": "rT",
      "from": "std",
      "array": "control_target_values",
      "column": 0
     },
     {
      "name": "vT",
      "from": "std",
      "array": "control_target_values",
      "column": 1
     }
    ]
   }
  }
 ],
 "archive": {
  "enabled": true
 },
 "resources": {
  "peak_bytes": 30000000
 }
}
