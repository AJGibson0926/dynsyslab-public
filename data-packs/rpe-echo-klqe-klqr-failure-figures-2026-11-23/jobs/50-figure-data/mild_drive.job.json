{
 "schema": "dynsyslab.compute-job/v1",
 "kind": "postprocess",
 "label": "mild_drive",
 "sources": [
  "${inputs.base}"
 ],
 "methods": [
  {
   "name": "figure_dataset",
   "settings": {
    "inputs": {
     "base": "${inputs.base}",
     "ref": "${inputs.ref}",
     "u1": "${inputs.u1}",
     "u2": "${inputs.u2}",
     "u3": "${inputs.u3}",
     "std": "${inputs.std}"
    },
    "arrays": [
     {
      "name": "time",
      "from": "base",
      "array": "time",
      "column": 0
     },
     {
      "name": "u_exact",
      "from": "ref",
      "array": "inverse_drive",
      "column": 0,
      "scale": 100.0
     },
     {
      "name": "u0",
      "from": "base",
      "array": "control_values",
      "column": 0,
      "onto": {
       "from": "base",
       "array": "time"
      },
      "scale": 100.0
     },
     {
      "name": "u1",
      "from": "u1",
      "array": "control_values",
      "column": 0,
      "onto": {
       "from": "base",
       "array": "time"
      },
      "scale": 100.0
     },
     {
      "name": "u2",
      "from": "u2",
      "array": "control_values",
      "column": 0,
      "onto": {
       "from": "base",
       "array": "time"
      },
      "scale": 100.0
     },
     {
      "name": "u3",
      "from": "u3",
      "array": "control_values",
      "column": 0,
      "onto": {
       "from": "base",
       "array": "time"
      },
      "scale": 100.0
     },
     {
      "name": "u_echo",
      "from": "std",
      "array": "applied_input",
      "column": 0,
      "onto": {
       "from": "base",
       "array": "time"
      },
      "clock": "estimator_time",
      "scale_before": 100.0,
      "nan_after_end": true
     }
    ]
   }
  }
 ],
 "archive": {
  "enabled": true
 },
 "resources": {
  "peak_bytes": 30000000
 }
}
