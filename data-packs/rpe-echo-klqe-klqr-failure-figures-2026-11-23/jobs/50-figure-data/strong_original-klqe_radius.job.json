{
 "schema": "dynsyslab.compute-job/v1",
 "kind": "postprocess",
 "label": "strong_original-klqe_radius",
 "sources": [
  "${inputs.base}"
 ],
 "methods": [
  {
   "name": "figure_dataset",
   "settings": {
    "inputs": {
     "base": "${inputs.base}",
     "ref": "${inputs.ref}",
     "klqe": "${inputs.klqe}"
    },
    "arrays": [
     {
      "name": "time",
      "from": "base",
      "array": "time",
      "column": 0
     },
     {
      "name": "radius",
      "from": "klqe",
      "array": "values",
      "column": 0,
      "onto": {
       "from": "base",
       "array": "time"
      }
     },
     {
      "name": "target",
      "from": "ref",
      "array": "target_values",
      "column": 0
     }
    ]
   }
  }
 ],
 "archive": {
  "enabled": true
 },
 "resources": {
  "peak_bytes": 30000000
 }
}
