include(CMakeParseArguments)

# Add one independently compiled DynSysLab extension. Extensions consume only
# the versioned C ABI unless their author explicitly opts into extra libraries.
function(dynsyslab_add_extension target)
  set(options NO_INSTALL USE_LINALG)
  set(oneValueArgs OUTPUT_NAME INCLUDE_DIR)
  set(multiValueArgs SOURCES LINK_LIBRARIES)
  cmake_parse_arguments(DSL_EXT "${options}" "${oneValueArgs}"
    "${multiValueArgs}" ${ARGN})
  if(NOT DSL_EXT_SOURCES)
    message(FATAL_ERROR "dynsyslab_add_extension(${target}) requires SOURCES")
  endif()
  add_library(${target} MODULE ${DSL_EXT_SOURCES})
  if(DSL_EXT_INCLUDE_DIR)
    set(_dsl_extension_include "${DSL_EXT_INCLUDE_DIR}")
    get_filename_component(_dsl_sdk_prefix "${DSL_EXT_INCLUDE_DIR}/.." ABSOLUTE)
  elseif(EXISTS "${CMAKE_SOURCE_DIR}/native/include/dynsyslab/extension_api.h")
    set(_dsl_extension_include "${CMAKE_SOURCE_DIR}/native/include")
  else()
    get_filename_component(_dsl_sdk_prefix
      "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../.." ABSOLUTE)
    set(_dsl_extension_include "${_dsl_sdk_prefix}/include")
  endif()
  if(NOT EXISTS "${_dsl_extension_include}/dynsyslab/extension_api.h")
    message(FATAL_ERROR
      "DynSysLab extension SDK header not found under ${_dsl_extension_include}")
  endif()
  target_include_directories(${target} PRIVATE "${_dsl_extension_include}")
  target_compile_features(${target} PRIVATE cxx_std_17)
  if(DSL_EXT_USE_LINALG)
    if(TARGET dynsyslab_linalg)
      target_link_libraries(${target} PRIVATE dynsyslab_linalg)
    else()
      find_library(_dsl_linalg_library NAMES dynsyslab_linalg
        PATHS "${_dsl_sdk_prefix}/lib" NO_DEFAULT_PATH REQUIRED)
      target_link_libraries(${target} PRIVATE "${_dsl_linalg_library}")
    endif()
  endif()
  if(DSL_EXT_LINK_LIBRARIES)
    target_link_libraries(${target} PRIVATE ${DSL_EXT_LINK_LIBRARIES})
  endif()
  if(DSL_EXT_OUTPUT_NAME)
    set_target_properties(${target} PROPERTIES OUTPUT_NAME "${DSL_EXT_OUTPUT_NAME}")
  endif()
  if(MSVC)
    target_compile_options(${target} PRIVATE /W4 /permissive- /EHsc /utf-8)
  else()
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic)
  endif()
  if(NOT DSL_EXT_NO_INSTALL)
    install(TARGETS ${target} LIBRARY DESTINATION extensions
      RUNTIME DESTINATION extensions)
  endif()
  unset(_dsl_extension_include)
  unset(_dsl_sdk_prefix)
  unset(_dsl_linalg_library)
endfunction()
