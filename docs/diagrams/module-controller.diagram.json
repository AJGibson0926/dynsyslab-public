  {"from": "plant", "to": "lift", "style": "flagged", "label": "x", "route": [{"x": "lift.left-40"}]},
  {"from": "lift", "to": "map"},
  {"from": "map", "to": "gain"},
  {"from": "gain", "to": "law", "from_side": "bottom", "to_side": "top"},
  {"from": "law", "to": "clamp", "from_side": "left", "to_side": "right"},
  {"from": "clamp", "to": "plant", "from_side": "left", "to_side": "bottom", "label": "u",
   "route": [{"x": "clamp.left-24"}, {"y": "plant.bottom+34"}]},
