   {"id": "outputs", "kind": "group", "layout": "column", "gap": 36,
    "children": [
     {"id": "history-series", "kind": "data", "label": "History series", "icon": "time_series", "notes": ["window x M coordinates", "a TimeSeries again"]},
     {"id": "hankel", "kind": "module", "label": "Hankel projection", "icon": "svd", "notes": ["(U^T h)/σ per window", "fast FFT path, same result"]}
    ]}
  ]
 },
 "edges": [
  {"from": "series", "to": "operations"},
  {"from": "operations", "to": "history", "label": "crop"},
