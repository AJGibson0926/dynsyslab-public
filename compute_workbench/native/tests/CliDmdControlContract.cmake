if(NOT EXISTS "${CLI}" OR NOT EXISTS "${SOURCE}" OR NOT IS_ABSOLUTE "${ROOT}")
  message(FATAL_ERROR "DMDc CLI contract requires an executable, fixture and absolute test root")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(work "${ROOT}/dmdc-${suffix}")
file(MAKE_DIRECTORY "${work}")
execute_process(COMMAND "${CLI}" import legacy-csv "${SOURCE}"
  --archive-root "${work}/archives" --map-system duffing
  --preset double_well_reference --coordinates dimensionless
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "DMDc controlled fixture import failed: ${error}")
endif()
file(GLOB_RECURSE sources "${work}/archives/solutions/*.npz")
list(LENGTH sources count)
if(NOT count EQUAL 1)
  message(FATAL_ERROR "DMDc controlled fixture missing")
endif()
list(GET sources 0 source)
file(WRITE "${work}/fit.json" "{\"schema\":\"dynsyslab.compute-job/v1\",\"kind\":\"postprocess\",\"label\":\"DMDc and EDMDc CLI contract\",\"sources\":[\"${source}\"],\"methods\":[{\"name\":\"dmdc\",\"settings\":{\"rank\":1}},{\"name\":\"edmdc\",\"settings\":{\"rank\":1}}],\"archive\":{\"enabled\":true}}")
execute_process(COMMAND "${CLI}" run "${work}/fit.json" --archive-root "${work}/archives"
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Native DMDc CLI failed: ${error}")
endif()
file(GLOB derived "${work}/archives/derived/koopman-dmdc/*.npz")
list(LENGTH derived count)
if(NOT count EQUAL 1)
  message(FATAL_ERROR "Native DMDc CLI did not publish its model: ${output}")
endif()
file(GLOB lifted "${work}/archives/derived/koopman-edmdc/*.npz")
list(LENGTH lifted count)
if(NOT count EQUAL 1)
  message(FATAL_ERROR "Native EDMDc CLI did not publish its model: ${output}")
endif()
file(REMOVE_RECURSE "${work}")
message(STATUS "Recorded controls -> native DMDc and EDMDc -> immutable Koopman archives: PASS")
