# Embeds the system catalogue data files (native/catalog/systems/<id>.json) in the foundation library,
# so every caller (tests, CLI, Viewer, the C ABI) reads the same data. The JSON files are the source
# of truth; this writes OUT, a C++ source with each file's text keyed by its system id.
#   cmake -DOUT=<file.cpp> -DSOURCE_DIR=<catalog dir> -P EmbedCatalog.cmake
file(GLOB files "${SOURCE_DIR}/*.json")
list(SORT files)
set(body "// Generated by native/cmake/EmbedCatalog.cmake from native/catalog/systems/*.json. Do not edit.\n")
string(APPEND body "#include <map>\n#include <string>\n\nnamespace dynsyslab::core::detail {\n")
string(APPEND body "const std::map<std::string, std::string>& systemCatalogTexts() {\n")
string(APPEND body "    static const std::map<std::string, std::string> texts = [] {\n")
string(APPEND body "        std::map<std::string, std::string> out;\n")
foreach(file IN LISTS files)
  get_filename_component(id "${file}" NAME_WE)
  file(READ "${file}" text)
  string(FIND "${text}" ")dslcatalog\"" bad)
  if(NOT bad EQUAL -1)
    message(FATAL_ERROR "${file} contains the raw-string delimiter )dslcatalog\"")
  endif()
  string(APPEND body "        {\n            std::string text;\n")
  string(LENGTH "${text}" length)
  set(offset 0)
  while(offset LESS length)  # chunks below the compiler's string-literal limit
    string(SUBSTRING "${text}" ${offset} 8000 chunk)
    string(APPEND body "            text += R\"dslcatalog(${chunk})dslcatalog\";\n")
    math(EXPR offset "${offset} + 8000")
  endwhile()
  string(APPEND body "            out.emplace(\"${id}\", std::move(text));\n        }\n")
endforeach()
string(APPEND body "        return out;\n    }();\n    return texts;\n}\n}  // namespace dynsyslab::core::detail\n")
file(WRITE "${OUT}.tmp" "${body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
